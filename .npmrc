; Pin this project to the public npm registry, regardless of the
; user-level ~/.npmrc default. Intuit developers (and anyone whose
; default registry is a corporate mirror) would otherwise write
; mirror URLs into package-lock.json on `npm install`, which then
; can't be resolved from GitHub-hosted CI runners.
;
; Auth tokens and other settings still come from ~/.npmrc — this
; file only overrides which registry tarball URLs get baked into
; the lockfile when run inside this repo.
registry=https://registry.npmjs.org/
